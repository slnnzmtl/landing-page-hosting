{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": ".output/public"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/projects(?:/.*)?", "status": 404, "dest": "/404.html" },
    { "src": "/finance", "status": 404, "dest": "/404.html" },
    { "src": "/finance/(.*)", "status": 404, "dest": "/404.html" },
    { "src": "/login", "status": 404, "dest": "/404.html" },
    { "src": "/(.*)", "dest": "/200.html" }
  ]
}
