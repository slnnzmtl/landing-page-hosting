{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": ".output/public"
      }
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.kazansky.dev"
        }
      ],
      "destination": "https://kazansky.dev/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "daniel.kazansky.dev"
        }
      ],
      "destination": "https://kazansky.dev/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_nuxt/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/projects/(.*)\\.(webp|png|jpg|jpeg|svg|gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/projects(?:/.*)?", "status": 404, "dest": "/404.html" },
    { "src": "/finance", "status": 404, "dest": "/404.html" },
    { "src": "/finance/(.*)", "status": 404, "dest": "/404.html" },
    { "src": "/login", "status": 404, "dest": "/404.html" },
    { "src": "/service(?:/.*)?", "dest": "/200.html" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
